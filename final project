import tkinter as tk
from tkinter import messagebox

# --- Functions ---
def add_task():
    task = entry.get().strip()
    if task:
        listbox.insert(tk.END, task)
        entry.delete(0, tk.END)
    else:
        messagebox.showwarning("Warning", "Enter a task first!")

def delete_task():
    try:
        selected = listbox.curselection()[0]
        listbox.delete(selected)
    except:
        messagebox.showwarning("Warning", "Select a task to delete!")

def clear_tasks():
    if listbox.size() > 0:
        listbox.delete(0, tk.END)
    else:
        messagebox.showinfo("Info", "No tasks to remove!")

# --- Window ---
root = tk.Tk()
root.title("To-Do List")
root.geometry("300x350")

# --- Entry ---
entry = tk.Entry(root, width=25, font=("Arial", 14))
entry.pack(pady=10)

# --- Buttons ---
tk.Button(root, text="Add Task", width=20, command=add_task).pack(pady=3)
tk.Button(root, text="Delete Selected", width=20, command=delete_task).pack(pady=3)
tk.Button(root, text="Remove All", width=20, command=clear_tasks).pack(pady=3)

# --- Listbox ---
listbox = tk.Listbox(root, width=30, height=12, font=("Arial", 12))
listbox.pack(pady=10)

# --- Run ---
root.mainloop()
